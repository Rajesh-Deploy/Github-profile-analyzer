# ==============================================================================
# GitHub Profile Analyzer Backend Environment Template
# Copy this file to .env and configure accordingly
# ==============================================================================

# Port the server will listen on (Railway sets this automatically)
PORT=5000

# Server environment (production or development)
NODE_ENV=production

# URLs for CORS and Swagger configuration
FRONTEND_URL=https://your-frontend-app.vercel.app
BACKEND_URL=https://your-backend-app.up.railway.app

# Database configuration (Connection URI)
# Highly recommended for Railway! Copy MYSQL_URL or DATABASE_URL from your DB service
MYSQL_URL=mysql://root:password@localhost:3306/github_profile_analyzer
# DATABASE_URL=mysql://root:password@localhost:3306/github_profile_analyzer

# Alternately, individual database configuration variables:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=github_profile_analyzer
DB_USER=root
DB_PASSWORD=password

# GitHub Integration
# Generating a personal access token is required to avoid rate limits
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
GITHUB_API_BASE_URL=https://api.github.com
