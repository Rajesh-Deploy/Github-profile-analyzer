# ==========================================
# GitHub Profile Analyzer Backend Environment Template
# Copy this file to .env and configure accordingly
# ==========================================

# Port the server will listen on (Railway sets this automatically)
PORT=5000

# Server environment (production or development)
NODE_ENV=production

# URLs for CORS and Swagger configuration
FRONTEND_URL=https://your-project.vercel.app
BACKEND_URL=https://your-project.up.railway.app

# Database configuration (Standard variables)
# If deploying on Railway, these can also be automatically mapped to
# MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, and MYSQLPASSWORD.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=github_profile_analyzer
DB_USER=raju
DB_PASSWORD=your_secure_password

# GitHub Integration
# Generating a personal access token is required to avoid rate limits
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
GITHUB_API_BASE_URL=https://api.github.com
